{
  "extends": "./tooling/typescript/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@carhire/types": ["./packages/types/src/index.ts"],
      "@carhire/types/*": ["./packages/types/src/*"],
      "@car-hire-os/types": ["./packages/types/src/index.ts"],
      "@car-hire-os/types/*": ["./packages/types/src/*"],
      "@carhire/contracts": ["./packages/contracts/src/index.ts"],
      "@carhire/contracts/*": ["./packages/contracts/src/*"],
      "@car-hire-os/contracts": ["./packages/contracts/src/index.ts"],
      "@car-hire-os/contracts/*": ["./packages/contracts/src/*"],
      "@carhire/validation": ["./packages/validation/src/index.ts"],
      "@carhire/validation/*": ["./packages/validation/src/*"],
      "@car-hire-os/validation": ["./packages/validation/src/index.ts"],
      "@car-hire-os/validation/*": ["./packages/validation/src/*"],
      "@carhire/ui": ["./packages/ui/src/index.ts"],
      "@carhire/ui/*": ["./packages/ui/src/*"],
      "@car-hire-os/ui": ["./packages/ui/src/index.ts"],
      "@car-hire-os/ui/*": ["./packages/ui/src/*"],
      "@carhire/config": ["./packages/config/src/index.ts"],
      "@carhire/config/*": ["./packages/config/src/*"],
      "@car-hire-os/config": ["./packages/config/src/index.ts"],
      "@car-hire-os/config/*": ["./packages/config/src/*"],
      "@carhire/constants": ["./packages/constants/src/index.ts"],
      "@carhire/constants/*": ["./packages/constants/src/*"],
      "@car-hire-os/constants": ["./packages/constants/src/index.ts"],
      "@car-hire-os/constants/*": ["./packages/constants/src/*"],
      "@carhire/utils": ["./packages/utils/src/index.ts"],
      "@carhire/utils/*": ["./packages/utils/src/*"],
      "@car-hire-os/utils": ["./packages/utils/src/index.ts"],
      "@car-hire-os/utils/*": ["./packages/utils/src/*"],
      "@carhire/database": ["./packages/database/src/index.ts"],
      "@carhire/database/*": ["./packages/database/src/*"],
      "@car-hire-os/database": ["./packages/database/src/index.ts"],
      "@car-hire-os/database/*": ["./packages/database/src/*"],
      "@carhire/auth": ["./packages/auth/src/index.ts"],
      "@carhire/auth/*": ["./packages/auth/src/*"],
      "@car-hire-os/auth": ["./packages/auth/src/index.ts"],
      "@car-hire-os/auth/*": ["./packages/auth/src/*"],
      "@carhire/observability": ["./packages/observability/src/index.ts"],
      "@carhire/observability/*": ["./packages/observability/src/*"],
      "@car-hire-os/observability": ["./packages/observability/src/index.ts"],
      "@car-hire-os/observability/*": ["./packages/observability/src/*"],
      "@carhire/tenant-admin": ["./apps/tenant-admin/src/index.ts"],

      "@carhire/tenant-admin/*": ["./apps/tenant-admin/src/*"],
      "@carhire/platform-admin": ["./apps/platform-admin/src/index.ts"],
      "@carhire/platform-admin/*": ["./apps/platform-admin/src/*"],
      "@carhire/public-web": ["./apps/public-web/src/index.ts"],
      "@carhire/public-web/*": ["./apps/public-web/src/*"],
      "@carhire/api": ["./apps/api/src/main.ts"],
      "@carhire/api/*": ["./apps/api/src/*"],
      "@carhire/worker": ["./apps/worker/src/main.ts"],
      "@carhire/worker/*": ["./apps/worker/src/*"]
    },
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src",
    "apps",
    "packages",
    "tooling",
    "scripts"
  ],
  "exclude": [
    "**/dist",
    "**/node_modules"
  ]
}
