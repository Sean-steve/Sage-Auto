# ============================================================================
# CAR HIRE OS — PRODUCTION IMMUTABLE MIGRATION RUNNER DOCKERFILE
# Dedicated Ephemeral Job for Database Migrations in Staging/Production
# ============================================================================

FROM node:24-alpine AS base
WORKDIR /app
RUN npm install -g pnpm@9

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* ./
COPY packages/ ./packages/
COPY infrastructure/database/ ./infrastructure/database/
COPY scripts/ ./scripts/

RUN pnpm install --frozen-lockfile --prod=false

# The canonical migration CLI executes the TypeScript migration engine through
# tsx, so this image does not perform a separate package-level tsc build.
USER node

CMD ["pnpm", "db:migrate"]
